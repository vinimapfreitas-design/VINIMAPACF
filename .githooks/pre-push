#!/bin/sh
# Git pre-push hook for TypeScript syntax and type checking

echo "🔍 Executando verificação de sintaxe e tipos TypeScript (npm run lint)..."

npm run lint
STATUS=$?

if [ $STATUS -ne 0 ]; then
  echo "❌ Erro: A verificação TypeScript falhou. Corrija os erros de tipo antes de realizar o push."
  exit 1
fi

echo "✅ TypeScript validado com sucesso! Prosseguindo com o push..."
exit 0
